PORT=3000
NEXT_BASE_URL="http://localhost:3000"
BASE_URL="http://localhost:3000"

# Supabase. Local values: run `pnpm exec supabase status -o env` and copy them here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=your-secret-key
# At least 32 characters. Generate with `openssl rand -hex 32`.
UNSUBSCRIBE_TOKEN_SECRET=replace-with-at-least-32-random-characters
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 06 Amendment 2: Stripe (test mode), trial claims, cron, mail.
# Stripe values come from the Stripe dashboard in test mode; `stripe listen` prints the webhook secret.
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
# At least 32 characters. Generate with `openssl rand -hex 32`.
TRIAL_CLAIM_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-32-random-characters
# Local mail: Supabase Mailpit SMTP on the host (no auth).
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Avenro <no-reply@localhost>"
