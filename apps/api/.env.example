NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:51214/avenro
APP_ORIGIN=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
TRUSTED_PROXIES=
SHUTDOWN_GRACE_MS=10000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Local development placeholder only. Use a unique random key of at least 32 bytes in production.
AUTH_RATE_LIMIT_HMAC_KEY=replace-with-a-random-secret-of-at-least-32-bytes
OPENAPI_ENABLED=true

# Leave all mail settings empty to keep delivery disabled.
# Use the SMTP host shown for this Zoho account and port 465 (SSL) or 587 (STARTTLS).
# Use avenro@adityatripathi.dev for SMTP_USER and MAIL_FROM, with its app password.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Test-only: set NODE_ENV=test and use a distinct local avenro_test or avenro_test_* database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:51214/avenro_test
